generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                 @id @default(uuid())
  email                      String                 @unique
  passwordHash               String?                @map("password_hash")
  fullName                   String?                @map("full_name")
  name                       String?
  googleId                   String?                @unique @map("google_id")
  role                       String                 @default("STUDENT") // STUDENT, TEACHER, ADMIN
  avatarUrl                  String?                @map("avatar_url")
  initials                   String?                @default("U")
  avatarBg                   String?                @default("#3b82f6") @map("avatar_bg")
  refreshTokenHash           String?                @map("refresh_token_hash")
  failedLoginAttempts        Int                    @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime?              @map("locked_until")
  isEmailVerified            Boolean                @default(false) @map("is_email_verified")
  emailVerificationTokenHash String?                @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime?              @map("email_verification_expires_at")
  passwordResetTokenHash     String?                @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime?              @map("password_reset_expires_at")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt                  DateTime?              @map("deleted_at")

  assignmentSubmissions      AssignmentSubmission[]
  createdAssignments         Assignment[]
  attendanceRecords          AttendanceRecord[]
  chatMessages               ChatMessage[]
  studentMemberships         ClassroomMember[]
  teacherMemberships         ClassroomTeacher[]
  createdClassrooms          Classroom[]            @relation("ClassroomCreatedBy")
  uploadedMaterials          Material[]
  quizSubmissions            QuizSubmission[]
  studyGroupMemberships      StudyGroupMember[]
  createdStudyGroups         StudyGroup[]
  createdTopics              GroupTopic[]           @relation("TopicCreator")
  attendances                Attendance[]

  @@map("users")
}

model Classroom {
  id                 String              @id @default(uuid())
  title              String
  name               String?
  subject            String?
  description        String?
  inviteCode         String              @unique @map("invite_code")
  createdById        String              @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  chatMessages       ChatMessage[]
  members            ClassroomMember[]
  teachers           ClassroomTeacher[]
  createdBy          User                @relation("ClassroomCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  materials          Material[]
  quizzes            Quiz[]
  studyGroups        StudyGroup[]
  attendances        Attendance[]

  @@map("classrooms")
}

model ClassroomTeacher {
  id          String    @id @default(uuid())
  classroomId String    @map("classroom_id")
  userId      String    @map("user_id")
  isOwner     Boolean   @default(false) @map("is_owner")
  addedAt     DateTime  @default(now()) @map("added_at")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@map("classroom_teachers")
}

model ClassroomMember {
  id          String    @id @default(uuid())
  classroomId String    @map("classroom_id")
  userId      String    @map("user_id")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@map("classroom_members")
}

model Material {
  id            String    @id @default(uuid())
  title         String
  fileUrl       String    @map("file_url")
  fileType      String    @default("PDF") @map("file_type")
  fileSizeBytes Int?      @map("file_size_bytes")
  isVectorized  Boolean   @default(false) @map("is_vectorized")
  classroomId   String    @map("classroom_id")
  uploadedById  String    @map("uploaded_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Assignment {
  id          String                 @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?              @map("due_date")
  totalPoints Int                    @default(100) @map("total_points")
  classroomId String                 @map("classroom_id")
  createdById String                 @map("created_by_id")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  submissions AssignmentSubmission[]
  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("assignments")
}

model AssignmentSubmission {
  id             String     @id @default(uuid())
  assignmentId   String     @map("assignment_id")
  studentId      String     @map("student_id")
  attemptNumber  Int        @default(1) @map("attempt_number")
  isLatest       Boolean    @default(true) @map("is_latest")
  submissionText String?    @map("submission_text")
  fileUrl        String?    @map("file_url")
  grade          Float?
  feedback       String?
  submittedAt    DateTime   @default(now()) @map("submitted_at")
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId, attemptNumber])
  @@map("assignment_submissions")
}

model Quiz {
  id              String           @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int              @default(30) @map("duration_minutes")
  isPublished     Boolean          @default(false) @map("is_published")
  classroomId     String           @map("classroom_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  questions       QuizQuestion[]
  submissions     QuizSubmission[]
  classroom       Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String   @map("quiz_id")
  questionText  String   @map("question_text")
  questionType  String   @default("MULTIPLE_CHOICE") @map("question_type")
  options       String?
  correctAnswer String   @map("correct_answer")
  points        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizSubmission {
  id            String   @id @default(uuid())
  quizId        String   @map("quiz_id")
  studentId     String   @map("student_id")
  attemptNumber Int      @default(1) @map("attempt_number")
  isLatest      Boolean  @default(true) @map("is_latest")
  score         Float?
  answers       String
  submittedAt   DateTime @default(now()) @map("submitted_at")
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId, attemptNumber])
  @@map("quiz_submissions")
}

model AttendanceSession {
  id          String             @id @default(uuid())
  classroomId String             @map("classroom_id")
  sessionCode String?            @map("session_code")
  isActive    Boolean            @default(true) @map("is_active")
  startedAt   DateTime           @default(now()) @map("started_at")
  endedAt     DateTime?          @map("ended_at")
  records     AttendanceRecord[]
  classroom   Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String            @id @default(uuid())
  sessionId   String            @map("session_id")
  studentId   String            @map("student_id")
  status      String            @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  checkedInAt DateTime          @default(now()) @map("checked_in_at")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model StudyGroup {
  id          String             @id @default(uuid())
  name        String
  description String?
  classroomId String?            @map("classroom_id")
  createdById String?            @map("created_by_id")
  icon        String?
  colorAccent String?            @map("color_accent")
  createdAt   DateTime           @default(now()) @map("created_at")
  messages    ChatMessage[]
  members     StudyGroupMember[]
  topics      GroupTopic[]
  classroom   Classroom?         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("study_groups")
}

model StudyGroupMember {
  id           String     @id @default(uuid())
  studyGroupId String     @map("study_group_id")
  userId       String     @map("user_id")
  role         String     @default("MEMBER") // OWNER, ADMIN, MEMBER
  permissions  String?    // JSON string for admin permissions
  joinedAt     DateTime   @default(now()) @map("joined_at")
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, userId])
  @@map("study_group_members")
}

model GroupTopic {
  id           String      @id @default(uuid())
  studyGroupId String      @map("study_group_id")
  name         String
  slug         String
  icon         String?     @default("#")
  color        String?     @default("#0d9488")
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  studyGroup   StudyGroup  @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  createdBy    User?       @relation("TopicCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([studyGroupId, slug])
  @@map("group_topics")
}

model ChatMessage {
  id           String      @id @default(uuid())
  senderId     String      @map("sender_id")
  classroomId  String?     @map("classroom_id")
  studyGroupId String?     @map("study_group_id")
  content      String
  attachments  String?
  createdAt    DateTime    @default(now()) @map("created_at")
  classroom    Classroom?  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sender       User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  studyGroup   StudyGroup? @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model SyncLog {
  id          String   @id @default(uuid())
  deviceHubId String   @map("device_hub_id")
  entityName  String   @map("entity_name")
  entityId    String   @map("entity_id")
  action      String   @map("action")
  payload     String
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@map("sync_logs")
}

model Attendance {
  id              String    @id @default(uuid())
  classId         String    @map("class_id")
  userId          String    @map("user_id")
  joinedAt        DateTime  @default(now()) @map("joined_at")
  leftAt          DateTime? @map("left_at")
  durationMinutes Int       @default(0) @map("duration_minutes")
  status          String    @default("PRESENT") // PRESENT, LATE, ABSENT
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  classroom       Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("attendances")
}